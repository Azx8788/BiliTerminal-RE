<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/btnUpdateDanmaku"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/text_panelvideosettings_04"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimary"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/list_divider" />

    <LinearLayout
        android:id="@+id/layoutQuality"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_panelvideosettings_03"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/textCurrentQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_panelvideosettings_02"
            android:textSize="11sp"
            android:alpha="0.7" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/list_divider" />

    <TextView
        android:id="@+id/btnMoveVideo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/uitext_followusersactivity_011"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimary"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/list_divider" />

    <TextView
        android:id="@+id/btnViewDetail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/text_panelvideosettings_01"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimary"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/list_divider" />

    <TextView
        android:id="@+id/btnCancelSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/btn_cancel"
        android:textSize="13sp"
        android:alpha="0.65"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>